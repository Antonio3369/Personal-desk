# Database — SQLite on the same machine (Tencent Lighthouse)
# Path is relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# Auth — change these before going live
SESSION_SECRET="change-me-to-a-long-random-string"
APP_PASSWORD="desk2026"

# Optional: bcrypt hash instead of plain APP_PASSWORD
# APP_PASSWORD_HASH=""

# Optional: extra Server Actions origin (dev LAN etc.)
# DEV_ALLOWED_ORIGIN="192.168.1.20:6789"

# AI assistant (Volcengine Ark / 豆包) — server-side only, never expose to the browser
# FAB 入口已暂时隐藏；组件保留在 src/components/ai-assistant.tsx，恢复时在 layout 挂回 <AiAssistant />
# ARK_API_KEY="your-ark-api-key"
